<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CVCEntregas.Mobile.Views.ListaEntregasPage"
             Title="Lista de Entregas - Areieiro CVC">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Topo com Identificação e Botão do Administrador -->
        <Border Grid.Row="0" BackgroundColor="#212121" Padding="15">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Entregas Pendentes" 
                       TextColor="White" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />

                <!-- Botão visível apenas para o Administrador -->
                <Button Grid.Column="1"
                        x:Name="BtnNovaEntrega"
                        Text="+ Nova"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="10,0"
                        HeightRequest="36"
                        Clicked="OnNovaEntregaClicked"
                        IsVisible="False" />
            </Grid>
        </Border>

        <!-- Lista de Entregas -->
        <ScrollView Grid.Row="1" Padding="15">
            <VerticalStackLayout Spacing="15">
                <Border Padding="15" Stroke="#E0E0E0" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Carga: Areia Fina (HR)" FontAttributes="Bold" TextColor="#212121"/>
                        <Label Text="Status: Aguardando Saída" TextColor="#D32F2F"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>